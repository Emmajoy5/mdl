# Copy this file to ".env" (same folder as app.py) and set only the lines you
# need. Everything here is optional: the app runs with none of it set.

# Optional: set up the lab and its first admin account without the setup page
# (useful on a server or in Docker). Only read on the very first start; after
# that, change accounts on the Admin page or with manage.py.
# LAB_NAME=Quality Control Laboratory
# ADMIN_USERNAME=labadmin
# ADMIN_PASSWORD=choose-a-real-password-here

# --- Production / deployment (see README "Deploying for real use") ---
# Put everything the app writes (database, photos, models, session key) in
# one folder instead of next to app.py:
# APP_DATA_DIR=/var/lib/microbial-digital-library
#
# Behind an HTTPS reverse proxy: only send the session cookie over HTTPS, and
# trust the proxy's X-Forwarded-For header for per-IP rate limiting. Leave
# both off for plain http:// use, or you'll be logged out immediately.
# FORCE_HTTPS_COOKIES=1
# TRUST_PROXY_HEADERS=1

# The address printed labels' QR codes should open. Set this to the address
# your team really uses to reach the app (e.g. https://strains.mylab.org or
# http://lab-server:5000). Without it, QR codes use whatever address you were
# browsing at when you opened the print sheet -- which is useless to a phone if
# that was localhost.
# PUBLIC_BASE_URL=https://strains.example.org

# Who to contact: shown on the Contact page. Set only what you want people to
# see; anything left out is not shown. Messages sent through the Contact form
# are read by the lab's admins on the Admin page.
# CONTACT_NAME=Your Name
# CONTACT_ORG=Your Laboratory or Company
# CONTACT_EMAIL=you@example.org
# CONTACT_PHONE=+44 0000 000000
# CONTACT_WEBSITE=https://example.org
# CONTACT_NOTE=Usually replies within two working days.

# Forgotten passwords by email (optional). Without these, a person who forgets
# their password asks on the log-in page and a lab admin makes them a reset
# link. With them, the link is emailed to the address saved on the person's
# account. PUBLIC_BASE_URL (above) must also be set, because the link in the
# email is built from it.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls (port 587), ssl (port 465) or none
# SMTP_USERNAME=mdl@example.org
# SMTP_PASSWORD=app-password-here
# SMTP_FROM=Microbial Digital Library <mdl@example.org>
