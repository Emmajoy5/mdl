# Copy to lab.env (Docker) or to ../.env (no Docker) and edit.
# Keep this file private. It is not part of any backup archive.

# The lab and its first admin account, read only on first start. Leave these
# out to use the setup page instead (it asks for the code shown in the log).
LAB_NAME=Quality Control Laboratory
ADMIN_USERNAME=labadmin
ADMIN_PASSWORD=choose-a-long-password-here

# The address people will use. QR codes on printed labels open this address.
PUBLIC_BASE_URL=https://strains.yourorg.example

# Set both only when an HTTPS reverse proxy is in front of the app.
FORCE_HTTPS_COOKIES=1
TRUST_PROXY_HEADERS=1

# Shown on the Contact page. Remove any line you do not want shown.
CONTACT_NAME=Lab contact name
CONTACT_ORG=Your laboratory
CONTACT_EMAIL=lab-contact@yourorg.example

# How long a save waits for its turn when someone else is writing, in
# milliseconds (default 30000). A save that waits longer than this fails, so
# don't lower it much; raise it for a lab that imports very large spreadsheets.
# DB_BUSY_WAIT_MS=30000

