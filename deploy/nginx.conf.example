# nginx reverse proxy. Add your certificate paths or use your usual TLS setup.
server {
    listen 443 ssl;
    server_name strains.yourorg.example;
    # ssl_certificate     /etc/ssl/certs/strains.pem;
    # ssl_certificate_key /etc/ssl/private/strains.key;

    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
